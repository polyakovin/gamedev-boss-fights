{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mechanicIds", "ui", "profiles"],
  "properties": {
    "version": { "const": 1 },
    "mechanicIds": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": { "$ref": "#/definitions/uiCopy" },
        "ru": { "$ref": "#/definitions/uiCopy" }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "translations"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "translations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "ru"],
            "properties": {
              "en": { "$ref": "#/definitions/profileCopy" },
              "ru": { "$ref": "#/definitions/profileCopy" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "uiCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge",
        "blueprintTitle",
        "signalTitle",
        "responseTitle",
        "tuningTitle",
        "pitfallTitle",
        "escalationTitle"
      ],
      "properties": {
        "badge": { "type": "string", "minLength": 1 },
        "blueprintTitle": { "type": "string", "minLength": 1 },
        "signalTitle": { "type": "string", "minLength": 1 },
        "responseTitle": { "type": "string", "minLength": 1 },
        "tuningTitle": { "type": "string", "minLength": 1 },
        "pitfallTitle": { "type": "string", "minLength": 1 },
        "escalationTitle": { "type": "string", "minLength": 1 }
      }
    },
    "profileCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overview", "signal", "response", "tuning", "pitfall", "escalation"],
      "properties": {
        "overview": { "type": "string", "minLength": 1 },
        "signal": { "type": "string", "minLength": 1 },
        "response": { "type": "string", "minLength": 1 },
        "tuning": { "type": "string", "minLength": 1 },
        "pitfall": { "type": "string", "minLength": 1 },
        "escalation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
