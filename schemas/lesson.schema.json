{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "subtitle",
    "variant",
    "summary",
    "learning",
    "category",
    "readTime",
    "demo",
    "steps",
    "mistakes",
    "designNotes",
    "story",
    "adaptation",
    "distinction",
    "concepts",
    "examples",
    "reviewStatus",
    "sourceVersion"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "learning": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "readTime": {
      "type": "string",
      "minLength": 1
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "play",
        "pause",
        "restart",
        "timeline",
        "step",
        "phaseNames",
        "phaseDescriptions",
        "boss",
        "player",
        "danger",
        "path",
        "locked",
        "safe",
        "reducedMotion",
        "diagramDescription"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "play": {
          "type": "string",
          "minLength": 1
        },
        "pause": {
          "type": "string",
          "minLength": 1
        },
        "restart": {
          "type": "string",
          "minLength": 1
        },
        "timeline": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "phaseNames": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "phaseDescriptions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boss": {
          "type": "string",
          "minLength": 1
        },
        "player": {
          "type": "string",
          "minLength": 1
        },
        "danger": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locked": {
          "type": "string",
          "minLength": 1
        },
        "safe": {
          "type": "string",
          "minLength": 1
        },
        "reducedMotion": {
          "type": "string",
          "minLength": 1
        },
        "diagramDescription": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mistakes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "designNotes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "distinction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "body"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "game", "boss", "body", "video", "videoDurationSeconds"],
        "properties": {
          "dimension": {
            "enum": ["2D", "3D"]
          },
          "game": {
            "type": "string",
            "minLength": 1
          },
          "boss": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "video": {
            "type": "string",
            "format": "https-url"
          },
          "videoDurationSeconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "reviewStatus": {
      "enum": ["needs-review", "reviewed"]
    },
    "sourceVersion": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mechanic lesson translation"
}
